# Copy to .env and fill in. Never commit .env.

# --- Site ------------------------------------------------------------------
# production makes missing secrets fatal at startup and enables proxy headers.
CLOUDSET_ENV=production
# Bare domain (no https://). Used by Caddy for the certificate and the www redirect.
CLOUDSET_DOMAIN=cloudset.dev
# Address that appears in emails and links.
CLOUDSET_PUBLIC_URL=https://cloudset.dev
# Local development: leave CLOUDSET_ENV unset and use http://127.0.0.1:8080.

# --- Secrets ---------------------------------------------------------------
# Generate each with: openssl rand -hex 24
CLOUDSET_ADMIN_TOKEN=
# Signs confirmation, manage, and unsubscribe links. Changing it invalidates
# every link already sent.
CLOUDSET_SECRET_KEY=

# --- Admin access ----------------------------------------------------------
# Space-separated IPs or CIDRs allowed to reach /admin through Caddy.
# Everyone else gets a 404. Find yours with: curl -4 ifconfig.me
CLOUDSET_ADMIN_ALLOW=203.0.113.4/32

# --- Forecast --------------------------------------------------------------
# auto uses live HRRR snapshots when present and falls back to demo safely.
CLOUDSET_FORECAST_MODE=auto
CLOUDSET_TIMEZONE=America/New_York
CLOUDSET_MAX_SUBSCRIPTIONS_PER_EMAIL=5

# --- Email (Resend over SMTP) ----------------------------------------------
# Without a host, messages are logged instead of sent.
CLOUDSET_SMTP_HOST=smtp.resend.com
# DigitalOcean blocks outbound 25/465/587 on most accounts. Resend also listens
# on 2587 (STARTTLS) and 2465 (TLS), so use 2587 on the droplet.
CLOUDSET_SMTP_PORT=2587
CLOUDSET_SMTP_USER=resend
CLOUDSET_SMTP_PASSWORD=
CLOUDSET_SMTP_FROM=Cloudset <alerts@cloudset.dev>
CLOUDSET_SMTP_TLS=true

# --- Optional --------------------------------------------------------------
CLOUDSET_DONATE_URL=https://ko-fi.com/yourname
