# Bind only to the LAN unless you add authentication/reverse proxying.
CLOUDSET_HOST=0.0.0.0
CLOUDSET_PORT=8080
CLOUDSET_DB=data/cloudset.db
CLOUDSET_ADMIN_TOKEN=
CLOUDSET_FORECAST_MODE=demo

# Optional SMTP delivery. When unset, messages are logged instead.
CLOUDSET_SMTP_HOST=
CLOUDSET_SMTP_PORT=587
CLOUDSET_SMTP_USER=
CLOUDSET_SMTP_PASSWORD=
CLOUDSET_SMTP_FROM=Cloudset <sunsets@example.com>
CLOUDSET_SMTP_TLS=true

